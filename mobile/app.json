{
  "expo": {
    "name": "L2 One - Sistema de Produtividade",
    "slug": "l2-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.l2representacoes.l2one",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.l2representacoes.l2one",
      "permissions": [
        "ACCESS_NETWORK_STATE"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-background-task",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir localização para registrar o check-in da visita, quando você solicitar."
        }
      ],
      "expo-font"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "releaseStage": "pilot"
    },
    "owner": "l2representacoes"
  }
}
